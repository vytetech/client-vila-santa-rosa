# Vila Santa Rosa — variáveis de ambiente Railway

# Obrigatória em produção
DATABASE_URL=

# Runtime
NODE_ENV=production
UPLOAD_DIR=/app/dist/public/images/uploads

# Admin por /admin-access (opcional; contas admin do banco continuam válidas)
ADMIN_USER=
ADMIN_PASS=
ADMIN_SESSION_TTL_MINUTES=120

# Kimi OAuth opcional
APP_ID=
APP_SECRET=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=

# SMTP opcional para redefinição de senha
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
